{
  "name": "@nacho-labs/nachos-embeddings",
  "version": "0.6.0",
  "description": "Modular vector embeddings and semantic search — local Transformers.js or AWS Bedrock providers",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "nachos-embeddings": "./bin/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./providers": {
      "types": "./dist/providers/types.d.ts",
      "import": "./dist/providers/types.js"
    },
    "./bedrock": {
      "types": "./dist/providers/bedrock/index.d.ts",
      "import": "./dist/providers/bedrock/index.js"
    }
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint \"src/**/*.ts\" \"tests/**/*.ts\" \"bin/**/*.js\" \"scripts/**/*.mjs\" vitest.config.ts",
    "lint:fix": "eslint \"src/**/*.ts\" \"tests/**/*.ts\" \"bin/**/*.js\" \"scripts/**/*.mjs\" vitest.config.ts --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist *.tsbuildinfo",
    "prepublishOnly": "npm run build",
    "typecheck:tests": "tsc -p tsconfig.eslint.json --noEmit",
    "smoke:pack": "node scripts/smoke-pack.mjs",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run typecheck:tests && npm run build && npm run test:coverage && npm run smoke:pack",
    "prepare": "node scripts/install-hooks.mjs"
  },
  "keywords": [
    "embeddings",
    "vector-search",
    "semantic-search",
    "transformers",
    "ml",
    "local",
    "privacy",
    "ai",
    "nlp",
    "similarity",
    "bedrock",
    "aws",
    "provider"
  ],
  "author": "Nate Richardson <hello@naterichardson.com> (https://naterichardson.com)",
  "license": "MIT",
  "engines": {
    "node": ">=20.9.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nacho-Labs-LLC/nachos-embeddings.git"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.2"
  },
  "peerDependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.0.0",
    "@aws-sdk/credential-provider-ini": "^3.0.0",
    "@aws-sdk/credential-providers": "^3.0.0"
  },
  "peerDependenciesMeta": {
    "@aws-sdk/client-bedrock-runtime": {
      "optional": true
    },
    "@aws-sdk/credential-provider-ini": {
      "optional": true
    },
    "@aws-sdk/credential-providers": {
      "optional": true
    }
  },
  "devDependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1169.0",
    "@aws-sdk/credential-provider-ini": "^3.973.30",
    "@aws-sdk/credential-providers": "^3.1169.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@typescript-eslint/eslint-plugin": "^8.72.2",
    "@typescript-eslint/parser": "^8.72.2",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "simple-git-hooks": "2.14.0",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "brace-expansion": "5.0.13",
    "minimatch": "11.0.8"
  },
  "simple-git-hooks": {
    "pre-commit": "npm run lint && npm run format:check && npm run typecheck && npm run typecheck:tests",
    "pre-push": "npm run check"
  }
}
